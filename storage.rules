rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Videos: authenticated users can write, anyone can read
    match /videos/{allPaths=**} {
      allow read;
      allow write: if request.auth != null;
    }
    // Broker logos: authenticated users can write, anyone can read
    match /brokers/{allPaths=**} {
      allow read;
      allow write: if request.auth != null;
    }
    // Robot .set files: anyone can read, authenticated can write
    match /robot-sets/{allPaths=**} {
      allow read;
      allow write: if request.auth != null;
    }
    // Team member photos: anyone can read, authenticated can write
    match /team/{allPaths=**} {
      allow read;
      allow write: if request.auth != null;
    }
    // Robots: authenticated users can write, authenticated can read
    match /robots/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
  }
}
